# ================= LLM 配置 =================
# [备选配置] Cloudflare Workers AI - 智谱 GLM-4.7-Flash 配置
# LLM_MODEL=@cf/zai-org/glm-4.7-flash
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/e6175ad163bd8b2ea0dad6cdd71b3a38/ai/v1
# 在 Cloudflare 控制台 -> My Profile -> API Tokens 创建带 Account -> Workers AI -> Read 权限的 Token
# LLM_API_KEY=your_cloudflare_api_token_here

# [默认推荐] DeepSeek 配置（默认关闭深度思考以获得更快响应）
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key_here
LLM_ENABLE_THINKING=false
# LLM_REASONING_EFFORT=high

# 商城后台 API 配置
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# 金融中台 API 配置
FINANCE_API_BASE_URL=http://127.0.0.1:8000/api/v1
FINANCE_DEFAULT_CUSTOMER_NO=CUS00000001

# 数据库配置
DATABASE_URL=mysql+aiomysql://root:123456@127.0.0.1:3306/customer_service?charset=utf8mb4

# 服务启动配置
APP_HOST=0.0.0.0
APP_PORT=18082

# Langfuse 可观测性配置
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_ENABLED=true

# 金融智脑 RAG 服务配置
RAG_API_BASE_URL=http://127.0.0.1:8001
RAG_IMPORT_BASE_URL=http://127.0.0.1:8002
RAG_ENABLED=true
RAG_TOP_K=4
RAG_ENABLE_HYDE=false
RAG_ENABLE_WEB=false
RAG_TIMEOUT_SECONDS=15.0
